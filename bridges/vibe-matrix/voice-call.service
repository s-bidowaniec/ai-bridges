[Unit]
Description=vibe-matrix voice call bot (m.call / MSC3245, prototyp Python)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/vibebridge/bridge
EnvironmentFile=/home/vibebridge/bridge/env
ExecStart=/usr/bin/python3 /home/vibebridge/bridge/voice_call.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
