# vibe-matrix-rs — przykładowy plik środowiskowy.
# SKOPIUJ do miejsca wskazanego przez unit (NIGDY nie commituj prawdziwego pliku!):
#   system: /etc/vibe-matrix-rs.env lub /etc/vibe-matrix-rs/<agent>.env
#           owner root:vibe-matrix-rs, chmod 640
#   user:   ~/.config/vibe-matrix-rs/<agent>.env, chmod 600
#
# Repo jest PUBLICZNE — sekrety tylko tutaj, lokalnie, poza repo.

# Homeserver Matrix (bez końcowego /). Wymagane https:// —
# ALLOW_INSECURE_HTTP=1 tylko świadomie, lokalnie (token leci Bearerem).
MATRIX_HOMESERVER=https://matrix.owl-post.eu
# Token dostępu bota (zaloguj bota przez /_matrix/client/v3/login i wklej access_token)
MATRIX_ACCESS_TOKEN=syT_...
# Pokój, w którym działa ta instancja (np. !abc123:matrix.owl-post.eu)
MATRIX_ROOM_ID=!xxxx:matrix.owl-post.eu
# MXID bota, np. @vibe:matrix.owl-post.eu (żeby ignorować własne wiadomości)
MATRIX_BOT_USER_ID=@vibe:matrix.owl-post.eu
# Allowlista nadawców (oddzielone przecinkami); puste = każdy w pokoju
MATRIX_ALLOWED_USERS=@stanislaw:matrix.owl-post.eu

# Inbound rate limit: max wiadomości na minutę od jednego nadawcy
INBOUND_MAX_PER_MIN=6
# Max eventów w zbiorze dedup (po przekroczeniu zbiór jest czyszczony z warningiem)
MAX_SEEN_EVENTS=100000
# Timeout pojedynczej odpowiedzi agenta (sekundy)
VIBE_TIMEOUT_SECS=600
# Sync long-poll (ms)
SYNC_TIMEOUT_MS=30000

# Pliki stanu (system: /var/lib/vibe-matrix-rs, user: pod ~/.local/state/vibe-matrix-rs)
STATE_FILE=/var/lib/vibe-matrix-rs/seen.txt
SESSION_FILE=/var/lib/vibe-matrix-rs/session.txt
AGENT_FILE=/var/lib/vibe-matrix-rs/agent.txt
VOICE_FILE=/var/lib/vibe-matrix-rs/voice.txt
UPLOADS_DIR=/var/lib/vibe-matrix-rs/uploads
VOICE_DIR=/var/lib/vibe-matrix-rs/voice
VOICE_FALLBACK_SECS=15

# Agent runtime (v5 tmux dla agy, v9 subprocess --resume dla vibe/codex/claude)
TMUX_PREFIX=vibe-matrix-rs
# Tryb agenta: domyślnie tmux — każdy natywny agent (vibe/codex/claude/agy) żyje jako pełne TUI
# w sesji tmux <TMUX_PREFIX>-<agent>; podpinasz się `tmux attach` i piszesz w tym samym oknie co Matrix.
# AGENT_MODE=subprocess|oneshot = tylko opt-in: headless `AGENT -p --resume <sid>` bez okna TUI.
AGENT_MODE=tmux
# Socket tmux pod $HOME (unit ma PrivateTmp=true — bez tego `tmux attach` z konsole nie widzi sesji!)
# W shellu użytkownika: export TMUX_TMPDIR=$HOME/.local/state/vibe-matrix-rs/tmux
TMUX_TMPDIR=/home/stanislaw/.local/state/vibe-matrix-rs/tmux
# Opcjonalnie: konkretna sesja tmux zamiast <TMUX_PREFIX>-<agent> (np. własne okno agenta)
# TMUX_SESSION=vibe-matrix-rs-codex
VIBE_WORKDIR=/var/lib/vibe-matrix-rs/vibe-work
AGENT_HOME=/var/lib/vibe-matrix-rs/agent-home
# Opcjonalny PATH dla subprocessu agenta (domyślnie dziedziczony z PATH procesu)
# AGENT_PATH=/var/lib/vibe-matrix-rs/.local/bin:/usr/local/bin:/usr/bin:/bin
# Komenda agy (Antigravity) — default "agy" z PATH; ustaw pełną ścieżkę jeśli trzeba
# AGY_CMD=/var/lib/vibe-matrix-rs/.local/bin/agy
VIBE_CMD=vibe
VIBE_ENV_KEYS=MISTRAL_API_KEY

# Voice STT/TTS fallback (Mistral API) — opcjonalne
# MISTRAL_API_KEY=...
# STT_MODEL=voxtral-mini-latest
# TTS_MODEL=voxtral-mini-tts-latest
# TTS_VOICE=gb_jane_neutral

RUST_LOG=info
