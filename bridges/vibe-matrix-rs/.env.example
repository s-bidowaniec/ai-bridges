# vibe-matrix-rs — przykładowy plik środowiskowy.
# SKOPIUJ do miejsca wskazanego przez unit (NIGDY nie commituj prawdziwego pliku!):
#   system (root): /etc/vibe-matrix-rs/<agent>.env
#   user  (lokalnie): ~/.config/vibe-matrix-rs/<agent>.env
#   chmod 600
#
# Repo jest PUBLICZNE — sekrety tylko tutaj, lokalnie, poza repo.

# Homeserver Matrix (bez końcowego /)
MATRIX_HOMESERVER=https://matrix.owl-post.eu
# Token dostępu bota (zaloguj bota przez /_matrix/client/v3/login i wklej access_token)
MATRIX_ACCESS_TOKEN=syT_...
# Pokój, w którym działa ta instancja (np. !abc123:matrix.owl-post.eu)
MATRIX_ROOM_ID=!xxxx:matrix.owl-post.eu
# MXID bota, np. @vibe:matrix.owl-post.eu (żeby ignorować własne wiadomości)
MATRIX_BOT_USER_ID=@vibe:matrix.owl-post.eu
# Allowlista nadawców (oddzielone przecinkami); puste = każdy w pokoju
MATRIX_ALLOWED_USERS=@stanislaw:matrix.owl-post.eu

# Agent: preset vibe|agy|claude|codex LUB własna komenda w AGENT_CMD
AGENT=vibe
# AGENT_CMD="claude -p {prompt} --dangerously-skip-permissions"   # {prompt} = treść wiadomości
# Timeout pojedynczego wywołania agenta (sekundy)
AGENT_TIMEOUT_SECS=600
# Sync long-poll (ms)
SYNC_TIMEOUT_MS=30000
# Plik ze zbiorem przetworzonych eventów (dedup)
STATE_FILE=/var/lib/vibe-matrix-rs/vibe.seen.txt

# Środowisko procesu agenta: czysty env + PATH/HOME + wybrane klucze stąd
AGENT_HOME=/root
AGENT_PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Dodatkowe zmienne przekazywane agentowi (nazwy, przecinkami), np. MISTRAL_API_KEY.
# UWAGA (Linux/KDE): jeśli agent loguje się przez systemowy keyring (libsecret, np. vibe OAuth),
# przepuść też: DBUS_SESSION_BUS_ADDRESS,XDG_RUNTIME_DIR
AGENT_ENV_KEYS=MISTRAL_API_KEY

RUST_LOG=info
