# Przykład dla instalacji systemowej. Trzymaj rzeczywisty plik env poza repozytorium.
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_ACCESS_TOKEN_FILE=/etc/vibe-matrix-rs/matrix-token
MATRIX_BOT_DEVICE_ID=ID_URZADZENIA
MATRIX_STORE_DIR=/var/lib/vibe-matrix-rs/e2ee
MATRIX_STORE_PASSPHRASE_FILE=/etc/vibe-matrix-rs/matrix-store-passphrase
MATRIX_ROOM_ID=!pokoj:matrix.example.org
MATRIX_BOT_USER_ID=@bridge:matrix.example.org
MATRIX_ALLOWED_USERS=@operator:matrix.example.org
# Wybierz jedno ustawienie dostępu. Bez allowlisty start wymaga tego przełącznika.
# MATRIX_ALLOW_ALL_ROOM_MEMBERS=1

INBOUND_MAX_PER_MIN=6
MAX_PENDING_MEDIA=8
MAX_SEEN_EVENTS=100000
SYNC_TIMEOUT_MS=30000
STATE_FILE=/var/lib/vibe-matrix-rs/seen.txt
AGENT_FILE=/var/lib/vibe-matrix-rs/agent.txt
ACTIVE_TERMINAL_FILE=/var/lib/vibe-matrix-rs/active-terminal.txt
UPLOADS_DIR=/var/lib/vibe-matrix-rs/uploads
VOICE_DIR=/var/lib/vibe-matrix-rs/voice
VIBE_WORKDIR=/var/lib/vibe-matrix-rs/projekt
TMUX_PREFIX=vibe-matrix-rs
# Socket musi być wspólny z terminalem lokalnym i znajdować się poza prywatnym /tmp usługi.
# TMUX_TMPDIR=/var/lib/vibe-matrix-rs/tmux
# Opcjonalnie podepnij istniejącą sesję jako domyślną.
# TMUX_SESSION=moj-terminal
# VIBE_CMD=vibe
# CODEX_CMD=codex
# CLAUDE_CMD=claude
# AGY_CMD=agy

VOICE_INPUT_MODE=files
# MISTRAL_API_KEY=...
# STT_MODEL=voxtral-mini-latest
RUST_LOG=info
