# Szablon systemowy: jedna instancja na agenta (nie root).
#   setup:  useradd -r -d /var/lib/vibe-matrix-rs -s /usr/sbin/nologin vibe-matrix-rs
#   env:    /etc/vibe-matrix-rs/<agent>.env  owner root:vibe-matrix-rs, chmod 640
#   start:  systemctl enable --now vibe-matrix-rs@vibe
[Unit]
Description=vibe-matrix-rs (Rust bridge Matrix <-> agent, instancja %i)
After=network.target

[Service]
Type=simple
User=vibe-matrix-rs
Group=vibe-matrix-rs
StateDirectory=vibe-matrix-rs
Environment=HOME=/var/lib/vibe-matrix-rs
EnvironmentFile=/etc/vibe-matrix-rs/%i.env
ExecStart=/opt/ai-bridges/bridges/vibe-matrix-rs/target/release/bridge-headless
Restart=always
RestartSec=5

# hardening (bez MemoryDenyWriteExecute — vibe/Bun JIT wymaga W+X)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/vibe-matrix-rs
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
