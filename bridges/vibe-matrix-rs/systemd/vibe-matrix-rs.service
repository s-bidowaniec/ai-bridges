[Unit]
Description=vibe-matrix-rs (Rust bridge: Matrix room <-> vibe -p headless)
After=network.target matrix-synapse.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ai-bridges/bridges/vibe-matrix-rs
EnvironmentFile=/etc/vibe-matrix-rs.env
ExecStart=/opt/ai-bridges/bridges/vibe-matrix-rs/target/release/bridge-headless
Restart=always
RestartSec=5

# hardening (Faza 3 roadmapy — rozszerzymy)
# UWAGA: bez MemoryDenyWriteExecute — vibe (Bun/Node JIT) wymaga W+X.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
# vibe musi zapisywać logi/sesje w /root/.vibe, stan bridge w /var/lib
ReadWritePaths=/var/lib/vibe-matrix-rs /root/.vibe
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true

[Install]
WantedBy=multi-user.target
