[Unit]
Description=vibe-matrix-rs bridge (Matrix room <-> tmux agent, voice)
Wants=vibe-matrix-terminal.service
After=network-online.target vibe-matrix-terminal.service

[Service]
UMask=0077
Type=simple
EnvironmentFile=%h/.config/vibe-matrix-rs/env
Environment=TMUX_TMPDIR=%h/.local/share/vibe-matrix-rs/tmux
WorkingDirectory=%h/ai-bridges/bridges/vibe-matrix-rs
ExecStart=%h/ai-bridges/bridges/vibe-matrix-rs/target/release/bridge-headless
Restart=always
RestartSec=5

# hardening (user-level)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/vibe-matrix-rs %h/.config/vibe-matrix-rs %h/.vibe %h/.cache %h/ai-bridges
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
