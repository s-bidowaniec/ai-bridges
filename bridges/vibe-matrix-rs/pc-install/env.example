# vibe-matrix-rs — env dla PC (user-level). chmod 600!
# Token bota: Element -> Ustawienia -> Pomoc i zasoby -> Zaawansowane -> Access Token (lub bot przez Bot API)
MATRIX_HOMESERVER=https://matrix.owl-post.eu
MATRIX_ACCESS_TOKEN=syto_ TUTAJ_TOKEN
MATRIX_ROOM_ID=!TUTAJ:matrix.owl-post.eu
MATRIX_BOT_USER_ID=@vibe-rs:matrix.owl-post.eu
MATRIX_ALLOWED_USERS=@twoj-user:matrix.owl-post.eu

# voice (STT/TTS przez Mistral) — bez tego /voice odpowie tekstem
MISTRAL_API_KEY=TUTAJ_MISTRAL_KEY

# stan — wszystko pod home (user-level)
STATE_FILE=%h/.local/share/vibe-matrix-rs/seen.txt
SESSION_FILE=%h/.local/share/vibe-matrix-rs/session.txt
AGENT_FILE=%h/.local/share/vibe-matrix-rs/agent.txt
VOICE_FILE=%h/.local/share/vibe-matrix-rs/voice.txt
UPLOADS_DIR=%h/.local/share/vibe-matrix-rs/uploads
VIBE_WORKDIR=%h/.local/share/vibe-matrix-rs/vibe-work
TMUX_PREFIX=vibe-matrix-rs
# HOME agenta w trybie subprocess (opt-in AGENT_MODE=subprocess) — musi być zapisywalny
# (unit ma ProtectSystem=strict + ProtectHome=read-only, więc /var/lib odpada na PC)
AGENT_HOME=%h/.local/share/vibe-matrix-rs/agent-home

# agent w tmux (vibe domyślnie; /agent codex|claude|agy w pokoju)
VIBE_CMD=vibe
VIBE_TIMEOUT_SECS=600
SYNC_TIMEOUT_MS=30000
VIBE_ENV_KEYS=MISTRAL_API_KEY

# Tryb agenta: tmux = agent żyje w stałej sesji tmux <TMUX_PREFIX>-<agent> na tym PC —
# podpinasz się `tmux attach -t vibe-matrix-rs-vibe` i piszesz w tym samym oknie co Matrix.
# (subprocess = `vibe -p ... --resume <sid>` per wiadomość, bez wspólnego okna terminala)
AGENT_MODE=tmux
# Socket tmux pod $HOME (unit ma PrivateTmp=true — bez tego `tmux attach` z shella
# nie widziałby sesji mostka). install.sh dopisuje ten sam export do ~/.bashrc / ~/.zshrc.
TMUX_TMPDIR=%h/.local/share/vibe-matrix-rs/tmux
# Okno terminala: mostek sam otwiera okno podpięte do sesji agenta (auto-detect emulatora;
# puste = wyłączone; można wymusić np. TERMINAL_CMD="konsole -e"). Komenda /window w pokoju
# otwiera okno ponownie. Jedna sesja = jednocześnie lokalny terminal + Matrix.
# TERMINAL_CMD=

# voice modele (opcjonalnie)
# STT_MODEL=voxtral-mini-latest
# TTS_MODEL=voxtral-mini-tts-latest
# TTS_VOICE=gb_jane_neutral
