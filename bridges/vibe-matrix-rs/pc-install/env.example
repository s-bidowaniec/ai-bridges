# Ustawienia instalacji na PC. Plik env musi być prywatny (chmod 600).
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_ACCESS_TOKEN_FILE=%h/.config/vibe-matrix-rs/matrix-token
MATRIX_BOT_DEVICE_ID=ID_URZADZENIA
MATRIX_STORE_DIR=%h/.local/share/vibe-matrix-rs/e2ee
MATRIX_STORE_PASSPHRASE_FILE=%h/.config/vibe-matrix-rs/matrix-store-passphrase
MATRIX_ROOM_ID=!pokoj:matrix.example.org
MATRIX_BOT_USER_ID=@bridge:matrix.example.org
MATRIX_ALLOWED_USERS=@twoj-user:matrix.example.org
# Cały pokój może sterować tylko po jawnym włączeniu. Usuń wtedy allowlistę.
# MATRIX_ALLOW_ALL_ROOM_MEMBERS=1

STATE_FILE=%h/.local/share/vibe-matrix-rs/seen.txt
AGENT_FILE=%h/.local/share/vibe-matrix-rs/agent.txt
ACTIVE_TERMINAL_FILE=%h/.local/share/vibe-matrix-rs/active-terminal.txt
UPLOADS_DIR=%h/.local/share/vibe-matrix-rs/uploads
VOICE_DIR=%h/.local/share/vibe-matrix-rs/voice
VIBE_WORKDIR=%h/.local/share/vibe-matrix-rs/vibe-work
TMUX_PREFIX=vibe-matrix-rs
TMUX_TMPDIR=%h/.local/share/vibe-matrix-rs/tmux
INBOUND_MAX_PER_MIN=30
MAX_PENDING_MEDIA=8

# Opcjonalne ścieżki do natywnych binarek.
# VIBE_CMD=vibe
# CODEX_CMD=codex
# CLAUDE_CMD=claude
# AGY_CMD=agy

# transcribe wpisuje tekst do terminala. files używa katalogów voice/in i voice/out.
VOICE_INPUT_MODE=files
# MISTRAL_API_KEY=TUTAJ_MISTRAL_KEY
# STT_MODEL=voxtral-mini-latest
RUST_LOG=info
